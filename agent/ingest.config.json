{
  "$comment": "Scope for the knowledge ingest. Run `npm run ingest:preview` from /agent to see what this picks up before writing.",

  "sourceDir": "/Users/priscilla/jobagent",

  "include": ["**"],

  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/*.lock",
    "**/package-lock.json"
  ],

  "extensions": [
    ".md", ".markdown", ".txt", ".rst",
    ".html", ".htm",
    ".csv", ".json",
    ".pdf", ".docx"
  ],

  "maxFileBytes": 2000000,
  "maxFiles": 400,
  "chunkChars": 1200,
  "chunkOverlapChars": 150
}
